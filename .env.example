# このファイルを .env という名前でコピーして使う（.env は .gitignore 済み）
# ここに書いた値より OS の環境変数が優先される（同名の変数を setx 等で設定済みならそちらが有効）

# --- AI（MCP）用: 閲覧のみトークン ---
# 各アプリで「レコード閲覧」のみのトークンを発行して貼る
KSQL_TOKEN_DEALS_RO=
KSQL_TOKEN_CUSTOMERS_RO=

# --- ランナー（npm run validate / dry-run）用 ---
# ここには閲覧のみトークンの値を入れる（validate と dry-run はそれで動く）。
# 本実行（npm run job）をする人間は、書込可トークンを OS の環境変数に設定する
# （OS 環境変数が .env より優先されるため、この .env は閲覧のみのまま安全に共有できる）
KSQL_TOKEN_DEALS=
KSQL_TOKEN_CUSTOMERS=
KSQL_TOKEN_LOGS=
